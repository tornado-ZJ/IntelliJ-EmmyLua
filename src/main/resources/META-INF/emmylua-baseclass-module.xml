<!--
  ~ Custom extensions for BaseClass -> Module inference and the IDEA-native GUIExport editor.
  ~ No external GUI editor process is started.
  -->
<idea-plugin>
    <extensions defaultExtensionNs="com.tang.intellij.lua">
        <luaTypeInfer implementation="com.tang.intellij.lua.module.BaseClassModuleShortNamesManager"
                      id="baseClassModule"
                      order="first"/>
        <luaShortNamesManager implementation="com.tang.intellij.lua.module.BaseClassModuleShortNamesManager"
                              id="baseClassModule"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.tang.intellij.lua.guieditor.GuiEditorProjectSettings"/>
        <projectConfigurable id="preferences.EmmyLua.GuiEditor"
                             parentId="language"
                             displayName="EmmyLua 原生 GUI 编辑器"
                             instance="com.tang.intellij.lua.guieditor.GuiEditorConfigurable"/>
        <fileEditorProvider id="EmmyLua-Native-GUI-Editor"
                            implementation="com.tang.intellij.lua.guieditor.GuiEditorFileEditorProvider"/>
    </extensions>
</idea-plugin>
